          "primary": "#45c4b0",
          "primary-foreground": "#032019",
          "secondary": "#1a2624",
          "secondary-foreground": "#e6eeec",
          "muted": "#1a2624",
          "muted-foreground": "#93a5a1",
          "accent": "#16302c",
          "accent-foreground": "#c3ebe3",
          "destructive": "#f0715f",
          "destructive-foreground": "#2a0804",
          "success": "#4cc38a",
          "success-foreground": "#03200f",
          "warning": "#f0a54a",
          "warning-foreground": "#2a1600",
          "border": "#24332f",
          "input": "#56706b",
          "ring": "var(--primary)",
          "chart-1": "#45c4b0",
          "chart-2": "#6aa9e6",
          "chart-3": "#f0b257",
          "chart-4": "#b08ae0",
          "chart-5": "#a3b3af",
          "sidebar": "#0d1514",
          "sidebar-foreground": "var(--foreground)",
          "sidebar-primary": "var(--primary)",
          "sidebar-primary-foreground": "var(--primary-foreground)",
          "sidebar-accent": "var(--accent)",
          "sidebar-accent-foreground": "var(--accent-foreground)",
